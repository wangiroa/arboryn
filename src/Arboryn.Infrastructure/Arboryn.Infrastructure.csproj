<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Arboryn.Infrastructure</RootNamespace>
    <!-- Inc 6 : Scriban est requis par le brief mais toutes ses versions portent des
         advisories NuGet (NU1902 modérée / NU1903 élevée / NU1904 CRITIQUE —
         injection de template / évasion de bac à sable / ReDoS). Décision projet :
         on l'accepte car les templates sont rédigés par l'utilisateur lui-même (entrée
         de confiance) et le rendu se fait en mode restreint (LiquidTemplateContext sans
         I/O). Suppression limitée à ce projet, le seul à référencer Scriban.
         À retirer dès qu'une version corrigée de Scriban est disponible. Couvre aussi
         les advisories de Magick.NET et Tesseract réintroduits à l'Inc 7 (même décision). -->
    <NoWarn>$(NoWarn);NU1901;NU1902;NU1903;NU1904</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Arboryn.Domain\Arboryn.Domain.csproj" />
    <ProjectReference Include="..\Arboryn.Application\Arboryn.Application.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="Dapper" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <!-- Inc 4 : lecteurs de métadonnées de contenu. -->
    <PackageReference Include="TagLibSharp" />
    <PackageReference Include="PdfPig" />
    <PackageReference Include="VersOne.Epub" />
    <PackageReference Include="MetadataExtractor" />
    <!-- Inc 5 : empreinte perceptuelle d'images (pHash via ImageSharp). -->
    <PackageReference Include="CoenM.ImageSharp.ImageHash" />
    <!-- Inc 6 : moteur de templates (chemins/noms canoniques), sandboxé. -->
    <PackageReference Include="Scriban" />
    <!-- Inc 7 : rendu de miniatures (rasterisation PDF + images) et OCR des scans.
         Magick.NET et Tesseract portent des advisories NuGet (couvertes par le NoWarn
         ci-dessus, même classe que Scriban). Les adapters se dégradent proprement si le
         runtime natif / tessdata est absent. À réviser dès qu'une version corrigée existe. -->
    <PackageReference Include="Magick.NET-Q8-AnyCPU" />
    <PackageReference Include="Tesseract" />
  </ItemGroup>
  <ItemGroup>
    <None Update="Database\Migrations\*.sql">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
