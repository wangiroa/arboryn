<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Arboryn.UI</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;arm64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <!-- Packaging MSIX opt-in (Inc 13, B) : build/dev/CI par défaut = None (exe portable,
         lançable sans installation). Un build « msbuild /p:ArborynPackage=true » bascule en
         MSIX (packagé, signé) sans changer le comportement par défaut. -->
    <WindowsPackageType Condition="'$(ArborynPackage)' != 'true'">None</WindowsPackageType>
    <WindowsPackageType Condition="'$(ArborynPackage)' == 'true'">MSIX</WindowsPackageType>
    <!-- App non packagée : embarque le runtime Windows App SDK pour un exe portable
         qui démarre sans installation préalable du Windows App Runtime. -->
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- NETSDK1206 : RIDs win10-* portés par le Windows App SDK 1.5 lui-même, sans impact. -->
    <NoWarn>$(NoWarn);NETSDK1206</NoWarn>
    <Nullable>enable</Nullable>
    <ApplicationIcon>Assets\Arboryn.ico</ApplicationIcon>
    <!-- Version du produit (Inc 13, B) — à garder synchronisée avec Package.appxmanifest. -->
    <Version>0.13.0</Version>
    <FileVersion>0.13.0.0</FileVersion>
    <AssemblyVersion>0.13.0.0</AssemblyVersion>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Arboryn.Domain\Arboryn.Domain.csproj" />
    <ProjectReference Include="..\Arboryn.Application\Arboryn.Application.csproj" />
    <ProjectReference Include="..\Arboryn.Infrastructure\Arboryn.Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>
  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <Content Include="Assets\Arboryn.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Remove="Assets\generate-app-icon.ps1" />
    <None Include="Assets\generate-app-icon.ps1">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </None>
    <Content Remove="Assets\generate-msix-assets.ps1" />
    <None Include="Assets\generate-msix-assets.ps1">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </None>

    <!-- Assets visuels MSIX (Inc 13, B) — régénérables via Assets\generate-msix-assets.ps1. -->
    <Content Include="Assets\Square44x44Logo.png" />
    <Content Include="Assets\Square71x71Logo.png" />
    <Content Include="Assets\Square150x150Logo.png" />
    <Content Include="Assets\Square310x310Logo.png" />
    <Content Include="Assets\Wide310x150Logo.png" />
    <Content Include="Assets\StoreLogo.png" />
    <Content Include="Assets\SplashScreen.png" />
  </ItemGroup>

  <!-- Manifeste MSIX : inclus uniquement lors d'un build packagé (build/dev/CI inchangés). -->
  <ItemGroup Condition="'$(ArborynPackage)' == 'true'">
    <AppxManifest Include="Package.appxmanifest">
      <SubType>Designer</SubType>
    </AppxManifest>
  </ItemGroup>
</Project>
