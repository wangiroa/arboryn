<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Arboryn.UI.Pages.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:vm="using:Arboryn.UI.ViewModels">

    <ScrollViewer>
        <StackPanel Padding="32,24,32,32" Spacing="20" MaxWidth="1280">

            <!-- Head -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="Tableau de bord" Style="{StaticResource ArborynTitleText}"
                               Foreground="{ThemeResource ArborynTextPrimaryBrush}" />
                    <TextBlock Text="{x:Bind ViewModel.StatusLine, Mode=OneWay}"
                               Style="{StaticResource ArborynBodyText}"
                               Foreground="{ThemeResource ArborynTextSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Click="OnExportClick" IsEnabled="{x:Bind ViewModel.HasVolumes, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontFamily="{StaticResource ArborynIconFontFamily}" Glyph="&#xEDE1;" FontSize="14" />
                            <TextBlock Text="Exporter…" />
                        </StackPanel>
                    </Button>
                    <Button Click="OnRescanClick">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontFamily="{StaticResource ArborynIconFontFamily}" Glyph="&#xE895;" FontSize="14" />
                            <TextBlock Text="Lancer un scan…" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <muxc:ProgressBar IsIndeterminate="True" Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />

            <!-- KPI strip -->
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource ArborynCardBorder}">
                    <StackPanel Spacing="2">
                        <TextBlock Text="{x:Bind ViewModel.LogicalFilesText, Mode=OneWay}"
                                   Style="{StaticResource ArborynTitleText}"
                                   Foreground="{ThemeResource ArborynAccentTextBrush}" />
                        <TextBlock Text="œuvres uniques" Style="{StaticResource ArborynCaptionText}"
                                   Foreground="{ThemeResource ArborynTextSecondaryBrush}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource ArborynCardBorder}">
                    <StackPanel Spacing="2">
                        <TextBlock Text="{x:Bind ViewModel.FileInstancesText, Mode=OneWay}"
                                   Style="{StaticResource ArborynTitleText}"
                                   Foreground="{ThemeResource ArborynTextPrimaryBrush}" />
                        <TextBlock Text="copies physiques" Style="{StaticResource ArborynCaptionText}"
                                   Foreground="{ThemeResource ArborynTextSecondaryBrush}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource ArborynCardBorder}">
                    <StackPanel Spacing="2">
                        <TextBlock Text="{x:Bind ViewModel.RedundancyText, Mode=OneWay}"
                                   Style="{StaticResource ArborynTitleText}"
                                   Foreground="{ThemeResource ArborynCautionBrush}" />
                        <TextBlock Text="taux de redondance" Style="{StaticResource ArborynCaptionText}"
                                   Foreground="{ThemeResource ArborynTextSecondaryBrush}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="3" Style="{StaticResource ArborynCardBorder}">
                    <StackPanel Spacing="2">
                        <TextBlock Text="{x:Bind ViewModel.TotalSpaceText, Mode=OneWay}"
                                   Style="{StaticResource ArborynTitleText}"
                                   Foreground="{ThemeResource ArborynTextPrimaryBrush}" />
                        <TextBlock Text="espace physique total" Style="{StaticResource ArborynCaptionText}"
                                   Foreground="{ThemeResource ArborynTextSecondaryBrush}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Health -->
            <Border Style="{StaticResource ArborynCardBorder}">
                <StackPanel Spacing="14">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon FontFamily="{StaticResource ArborynIconFontFamily}" Glyph="&#xEA18;" FontSize="16" />
                        <TextBlock Text="Santé" Style="{StaticResource ArborynBodyStrongText}"
                                   Foreground="{ThemeResource ArborynTextPrimaryBrush}" />
                    </StackPanel>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="{x:Bind ViewModel.VolumesText, Mode=OneWay}"
                                       Style="{StaticResource ArborynSubtitleText}"
                                       Foreground="{ThemeResource ArborynTextPrimaryBrush}" />
                            <TextBlock Text="volumes en ligne" Style="{StaticResource ArborynCaptionText}"
                                       Foreground="{ThemeResource ArborynTextSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="{x:Bind ViewModel.PendingOperationsText, Mode=OneWay}"
                                       Style="{StaticResource ArborynSubtitleText}"
                                       Foreground="{ThemeResource ArborynTextPrimaryBrush}" />
                            <TextBlock Text="opérations en attente" Style="{StaticResource ArborynCaptionText}"
                                       Foreground="{ThemeResource ArborynTextSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="2">
                            <TextBlock Text="{x:Bind ViewModel.StaleText, Mode=OneWay}"
                                       Style="{StaticResource ArborynSubtitleText}"
                                       Foreground="{ThemeResource ArborynCautionBrush}" />
                            <TextBlock Text="scans anciens (&gt; 30 j)" Style="{StaticResource ArborynCaptionText}"
                                       Foreground="{ThemeResource ArborynTextSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="3" Spacing="2">
                            <TextBlock Text="{x:Bind ViewModel.LastScanText, Mode=OneWay}"
                                       Style="{StaticResource ArborynSubtitleText}"
                                       Foreground="{ThemeResource ArborynTextPrimaryBrush}" />
                            <TextBlock Text="plus ancien scan" Style="{StaticResource ArborynCaptionText}"
                                       Foreground="{ThemeResource ArborynTextSecondaryBrush}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Category breakdown -->
            <Border Style="{StaticResource ArborynCardBorder}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Par catégorie" Style="{StaticResource ArborynBodyStrongText}"
                               Foreground="{ThemeResource ArborynTextPrimaryBrush}" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Categories, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:CategoryRow">
                                <Grid ColumnSpacing="12" Padding="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{x:Bind Label}"
                                               Style="{StaticResource ArborynBodyText}"
                                               Foreground="{ThemeResource ArborynTextPrimaryBrush}" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind CountText}" MinWidth="90"
                                               Style="{StaticResource ArborynCaptionText}"
                                               Foreground="{ThemeResource ArborynTextSecondaryBrush}" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind SpaceText}" MinWidth="80"
                                               TextAlignment="Right"
                                               Style="{StaticResource ArborynCaptionText}"
                                               Foreground="{ThemeResource ArborynTextSecondaryBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Matrix volume × category -->
            <Border Style="{StaticResource ArborynCardBorder}">
                <StackPanel Spacing="12">
                    <StackPanel Spacing="2">
                        <TextBlock Text="Volumes × catégories" Style="{StaticResource ArborynBodyStrongText}"
                                   Foreground="{ThemeResource ArborynTextPrimaryBrush}" />
                        <TextBlock Text="Chaque cellule : présent / attendu dans le périmètre. Rouge = manque (à copier), ambre = surplus (hors scope)."
                                   Style="{StaticResource ArborynCaptionText}"
                                   Foreground="{ThemeResource ArborynTextSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Volumes, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:VolumeMatrixRow">
                                <Border Style="{StaticResource ArborynSecondaryCardBorder}" Margin="0,0,0,10">
                                    <StackPanel Spacing="8">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Spacing="2">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="{x:Bind Name}"
                                                               Style="{StaticResource ArborynBodyStrongText}"
                                                               Foreground="{ThemeResource ArborynTextPrimaryBrush}" />
                                                    <Border Style="{StaticResource ArborynBadgeBorder}">
                                                        <TextBlock Text="{x:Bind StatusLabel}" FontSize="11"
                                                                   Foreground="{ThemeResource ArborynTextSecondaryBrush}" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{x:Bind ScopeSummary}"
                                                           Style="{StaticResource ArborynCaptionText}"
                                                           Foreground="{ThemeResource ArborynTextSecondaryBrush}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind SpaceText}" VerticalAlignment="Center"
                                                           Style="{StaticResource ArborynCaptionText}"
                                                           Foreground="{ThemeResource ArborynTextSecondaryBrush}" />
                                                <Button Content="Détails" Click="OnVolumeDetailsClick"
                                                        Visibility="{x:Bind HasGapOrSurplus}" />
                                            </StackPanel>
                                        </Grid>
                                        <ItemsControl ItemsSource="{x:Bind Cells}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:MatrixCellView">
                                                    <Border Background="{x:Bind Background}"
                                                            CornerRadius="{StaticResource ArborynRadiusControl}"
                                                            Padding="8,4" Margin="0,0,8,8">
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <TextBlock Text="{x:Bind Label}" FontSize="11"
                                                                       Foreground="{x:Bind Foreground}" />
                                                            <TextBlock Text="{x:Bind ValueText}" FontSize="11" FontWeight="SemiBold"
                                                                       Foreground="{x:Bind Foreground}" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
