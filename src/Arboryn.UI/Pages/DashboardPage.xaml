<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Arboryn.UI.Pages.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:vm="using:Arboryn.UI.ViewModels">

    <ScrollViewer>
        <StackPanel Padding="32,24,32,32" Spacing="24" MaxWidth="1280">

            <!-- Page head -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="Tableau de bord" Style="{StaticResource ArborynTitleText}"
                               Foreground="{ThemeResource ArborynTextPrimaryBrush}" />
                    <TextBlock x:Name="SubtitleText"
                               Style="{StaticResource ArborynBodyText}"
                               Foreground="{ThemeResource ArborynTextSecondaryBrush}"
                               Text="Vue d'ensemble de votre bibliothèque." />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Click="OnRescanClick">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontFamily="{StaticResource ArborynIconFontFamily}"
                                      Glyph="&#xE895;" FontSize="14" />
                            <TextBlock Text="Lancer un scan…" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Grid 2 cols -->
            <Grid ColumnSpacing="20" RowSpacing="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.3*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Carte Santé -->
                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource ArborynCardBorder}">
                    <StackPanel Spacing="16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <FontIcon FontFamily="{StaticResource ArborynIconFontFamily}"
                                          Glyph="&#xEA18;" FontSize="18"
                                          Foreground="{ThemeResource ArborynTextPrimaryBrush}" />
                                <TextBlock Text="Santé du système"
                                           Style="{StaticResource ArborynBodyStrongText}"
                                           Foreground="{ThemeResource ArborynTextPrimaryBrush}" />
                            </StackPanel>
                            <Border Grid.Column="2"
                                    Background="{ThemeResource ArborynSuccessBgBrush}"
                                    CornerRadius="{StaticResource ArborynRadiusPill}"
                                    Padding="10,4">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Ellipse Width="8" Height="8"
                                             Fill="{ThemeResource ArborynSuccessBrush}" />
                                    <TextBlock Text="Opérationnel"
                                               Style="{StaticResource ArborynCaptionText}"
                                               Foreground="{ThemeResource ArborynSuccessBrush}" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid ColumnSpacing="12" RowSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource ArborynSecondaryCardBorder}">
                                <StackPanel Spacing="8">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Ellipse Width="8" Height="8"
                                                 Fill="{ThemeResource ArborynStatusOnlineBrush}" />
                                        <TextBlock Text="Volume actif"
                                                   Style="{StaticResource ArborynCaptionText}"
                                                   Foreground="{ThemeResource ArborynTextSecondaryBrush}" />
                                    </StackPanel>
                                    <TextBlock Text="default"
                                               Style="{StaticResource ArborynSubtitleText}"
                                               Foreground="{ThemeResource ArborynTextPrimaryBrush}" />
                                    <TextBlock Text="Multi-volume disponible à l'Inc 9"
                                               Style="{StaticResource ArborynCaptionText}"
                                               Foreground="{ThemeResource ArborynTextTertiaryBrush}" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource ArborynSecondaryCardBorder}">
                                <StackPanel Spacing="8">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon FontFamily="{StaticResource ArborynIconFontFamily}"
                                                  Glyph="&#xE823;" FontSize="12"
                                                  Foreground="{ThemeResource ArborynTextSecondaryBrush}" />
                                        <TextBlock Text="Opérations en attente"
                                                   Style="{StaticResource ArborynCaptionText}"
                                                   Foreground="{ThemeResource ArborynTextSecondaryBrush}" />
                                    </StackPanel>
                                    <TextBlock Text="0"
                                               Style="{StaticResource ArborynSubtitleText}"
                                               Foreground="{ThemeResource ArborynTextPrimaryBrush}" />
                                    <TextBlock Text="Aucune opération différée."
                                               Style="{StaticResource ArborynCaptionText}"
                                               Foreground="{ThemeResource ArborynTextTertiaryBrush}" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource ArborynSecondaryCardBorder}">
                                <StackPanel Spacing="8">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Ellipse Width="8" Height="8"
                                                 Fill="{ThemeResource ArborynStatusUnknownBrush}" />
                                        <TextBlock Text="Conflits non résolus"
                                                   Style="{StaticResource ArborynCaptionText}"
                                                   Foreground="{ThemeResource ArborynTextSecondaryBrush}" />
                                    </StackPanel>
                                    <TextBlock Text="0"
                                               Style="{StaticResource ArborynSubtitleText}"
                                               Foreground="{ThemeResource ArborynCautionBrush}" />
                                    <TextBlock Text="Détectés à partir de l'Inc 10."
                                               Style="{StaticResource ArborynCaptionText}"
                                               Foreground="{ThemeResource ArborynTextTertiaryBrush}" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource ArborynSecondaryCardBorder}">
                                <StackPanel Spacing="8">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon FontFamily="{StaticResource ArborynIconFontFamily}"
                                                  Glyph="&#xE895;" FontSize="12"
                                                  Foreground="{ThemeResource ArborynTextSecondaryBrush}" />
                                        <TextBlock Text="Dernier scan"
                                                   Style="{StaticResource ArborynCaptionText}"
                                                   Foreground="{ThemeResource ArborynTextSecondaryBrush}" />
                                    </StackPanel>
                                    <TextBlock x:Name="LastScanText" Text="—"
                                               Style="{StaticResource ArborynBodyStrongText}"
                                               Foreground="{ThemeResource ArborynTextPrimaryBrush}" />
                                    <TextBlock Text="USN Journal disponible à l'Inc 9."
                                               Style="{StaticResource ArborynCaptionText}"
                                               Foreground="{ThemeResource ArborynTextTertiaryBrush}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Carte Inventaire -->
                <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource ArborynCardBorder}">
                    <StackPanel Spacing="14">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon FontFamily="{StaticResource ArborynIconFontFamily}"
                                      Glyph="&#xE8F1;" FontSize="18" />
                            <TextBlock Text="Inventaire"
                                       Style="{StaticResource ArborynBodyStrongText}"
                                       Foreground="{ThemeResource ArborynTextPrimaryBrush}" />
                        </StackPanel>

                        <StackPanel Spacing="2">
                            <TextBlock x:Name="LogicalFilesText"
                                       Text="0"
                                       Style="{StaticResource ArborynTitleText}"
                                       Foreground="{ThemeResource ArborynAccentTextBrush}" />
                            <TextBlock Text="œuvres uniques (LogicalFiles)"
                                       Style="{StaticResource ArborynCaptionText}"
                                       Foreground="{ThemeResource ArborynTextSecondaryBrush}" />
                        </StackPanel>

                        <Border Background="{ThemeResource ArborynStrokeDividerBrush}" Height="1" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock x:Name="FileInstancesText" Text="0"
                                           Style="{StaticResource ArborynSubtitleText}"
                                           Foreground="{ThemeResource ArborynTextPrimaryBrush}" />
                                <TextBlock Text="copies (FileInstances)"
                                           Style="{StaticResource ArborynCaptionText}"
                                           Foreground="{ThemeResource ArborynTextSecondaryBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="2" HorizontalAlignment="Right">
                                <TextBlock x:Name="RedundancyText" Text="—"
                                           Style="{StaticResource ArborynSubtitleText}"
                                           Foreground="{ThemeResource ArborynCautionBrush}" />
                                <TextBlock Text="taux de redondance"
                                           Style="{StaticResource ArborynCaptionText}"
                                           Foreground="{ThemeResource ArborynTextSecondaryBrush}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Carte « À faire » -->
                <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource ArborynCardBorder}">
                    <StackPanel Spacing="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <FontIcon FontFamily="{StaticResource ArborynIconFontFamily}"
                                          Glyph="&#xEA80;" FontSize="18" />
                                <TextBlock Text="À faire"
                                           Style="{StaticResource ArborynBodyStrongText}"
                                           Foreground="{ThemeResource ArborynTextPrimaryBrush}" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="Suggéré"
                                       Style="{StaticResource ArborynCaptionText}"
                                       Foreground="{ThemeResource ArborynTextTertiaryBrush}"
                                       VerticalAlignment="Center" />
                        </Grid>

                        <StackPanel x:Name="TodosPanel" Spacing="8" />
                    </StackPanel>
                </Border>

                <!-- Activité récente -->
                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource ArborynCardBorder}">
                    <StackPanel Spacing="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <FontIcon FontFamily="{StaticResource ArborynIconFontFamily}"
                                          Glyph="&#xE81C;" FontSize="18" />
                                <TextBlock Text="Activité récente"
                                           Style="{StaticResource ArborynBodyStrongText}"
                                           Foreground="{ThemeResource ArborynTextPrimaryBrush}" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Style="{StaticResource ArborynSubtleButton}"
                                    Content="Tout voir"
                                    Click="OnGoToHistoryClick" />
                        </Grid>
                        <TextBlock x:Name="ActivityPlaceholder"
                                   Text="L'activité détaillée par catégorie d'opération (rename, move, copy, delete) sera affichée ici dès l'arrivée de l'écran Historique complet."
                                   Style="{StaticResource ArborynBodyText}"
                                   Foreground="{ThemeResource ArborynTextSecondaryBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>

            <TextBlock x:Name="StatusBar"
                       Style="{StaticResource ArborynCaptionText}"
                       Foreground="{ThemeResource ArborynTextTertiaryBrush}"
                       Text="" />
        </StackPanel>
    </ScrollViewer>
</Page>
