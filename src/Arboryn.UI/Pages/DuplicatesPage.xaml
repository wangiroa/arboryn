<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Arboryn.UI.Pages.DuplicatesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:vm="using:Arboryn.UI.ViewModels">

    <Grid Padding="32,24,32,16" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Page head -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock Text="Doublons" Style="{StaticResource ArborynTitleText}"
                           Foreground="{ThemeResource ArborynTextPrimaryBrush}" />
                <TextBlock x:Name="SummaryText"
                           Style="{StaticResource ArborynBodyText}"
                           Foreground="{ThemeResource ArborynTextSecondaryBrush}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                <Button Content="Choisir un dossier…" Click="OnPickFolderClick"
                        IsEnabled="{x:Bind ViewModel.CanScan, Mode=OneWay}" />
                <Button Content="Re-scanner" Click="OnRescanClick"
                        IsEnabled="{x:Bind ViewModel.CanRescan, Mode=OneWay}" />
                <Button Click="OnCancelClick"
                        Visibility="{x:Bind ViewModel.IsScanning, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontFamily="{StaticResource ArborynIconFontFamily}"
                                  Glyph="&#xE711;" FontSize="12" />
                        <TextBlock Text="Annuler" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Folder path + InfoBar safety -->
        <StackPanel Grid.Row="1" Spacing="8">
            <Border Background="{ThemeResource ArborynCardSecondaryBrush}"
                    CornerRadius="{StaticResource ArborynRadiusCard}"
                    BorderBrush="{ThemeResource ArborynStrokeCardBrush}"
                    BorderThickness="1"
                    Padding="12,8">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <FontIcon FontFamily="{StaticResource ArborynIconFontFamily}"
                              Glyph="&#xF12B;" FontSize="14"
                              Foreground="{ThemeResource ArborynTextSecondaryBrush}" />
                    <TextBlock Text="Dossier analysé :"
                               Style="{StaticResource ArborynCaptionText}"
                               Foreground="{ThemeResource ArborynTextSecondaryBrush}"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{x:Bind ViewModel.CurrentFolder, Mode=OneWay}"
                               Style="{StaticResource ArborynBodyText}"
                               Foreground="{ThemeResource ArborynTextPrimaryBrush}"
                               TextTrimming="CharacterEllipsis"
                               ToolTipService.ToolTip="{x:Bind ViewModel.CurrentFolder, Mode=OneWay}"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <Border Background="{ThemeResource ArborynCautionBgBrush}"
                    CornerRadius="{StaticResource ArborynRadiusCard}"
                    Padding="12,8">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <FontIcon FontFamily="{StaticResource ArborynIconFontFamily}"
                              Glyph="&#xE7BA;" FontSize="14"
                              Foreground="{ThemeResource ArborynCautionBrush}" />
                    <TextBlock Text="Aucune suppression n'est exécutée sans confirmation. Les fichiers partent vers la corbeille — annulable depuis cet écran."
                               Style="{StaticResource ArborynCaptionText}"
                               Foreground="{ThemeResource ArborynCautionBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Détection scope + actions globales -->
        <Grid Grid.Row="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="Périmètre :"
                               Style="{StaticResource ArborynCaptionText}"
                               Foreground="{ThemeResource ArborynTextSecondaryBrush}"
                               VerticalAlignment="Center" />
                    <ToggleSwitch MinWidth="0"
                                  OffContent="Ce scan uniquement"
                                  OnContent="Tout le catalogue"
                                  IsOn="{x:Bind ViewModel.DetectWholeCatalog, Mode=TwoWay}"
                                  VerticalAlignment="Center" />
                </StackPanel>
                <Button Click="OnDetectFuzzyClick"
                        IsEnabled="{x:Bind ViewModel.CanScan, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontFamily="{StaticResource ArborynIconFontFamily}"
                                  Glyph="&#xE721;" FontSize="12" />
                        <TextBlock Text="Détecter aussi les doublons flous" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button Click="OnUndoClick"
                        IsEnabled="{x:Bind ViewModel.CanScan, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontFamily="{StaticResource ArborynIconFontFamily}"
                                  Glyph="&#xE7A7;" FontSize="12" />
                        <TextBlock Text="Annuler la dernière suppression" />
                    </StackPanel>
                </Button>
                <Button Click="OnDeleteAllClick"
                        Style="{StaticResource AccentButtonStyle}"
                        IsEnabled="{x:Bind ViewModel.CanScan, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontFamily="{StaticResource ArborynIconFontFamily}"
                                  Glyph="&#xEA99;" FontSize="12" />
                        <TextBlock Text="Supprimer toute la sélection" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Status -->
        <TextBlock Grid.Row="3"
                   Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                   Style="{StaticResource ArborynBodyText}"
                   Foreground="{ThemeResource ArborynTextSecondaryBrush}"
                   TextWrapping="Wrap" />

        <!-- Groups list -->
        <Border Grid.Row="4" Style="{StaticResource ArborynCardBorder}" Padding="0">
            <ListView ItemsSource="{x:Bind ViewModel.Groups, Mode=OneWay}"
                      SelectionMode="None"
                      Background="Transparent">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="Padding" Value="16,12" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:DuplicateGroupItem">
                        <StackPanel Spacing="6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0"
                                        Background="{ThemeResource ArborynAccentSelectedBgBrush}"
                                        CornerRadius="{StaticResource ArborynRadiusPill}"
                                        Padding="10,3" Margin="0,0,12,0" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind KindLabel}"
                                               FontSize="11"
                                               Foreground="{ThemeResource ArborynAccentTextBrush}" />
                                </Border>
                                <TextBlock Grid.Column="1"
                                           Text="{x:Bind Title}"
                                           Style="{StaticResource ArborynBodyStrongText}"
                                           Foreground="{ThemeResource ArborynTextPrimaryBrush}"
                                           VerticalAlignment="Center"
                                           TextWrapping="Wrap" />
                                <Button Grid.Column="2" Content="Confirmer par hash"
                                        Click="OnConfirmHashClick"
                                        Margin="0,0,8,0"
                                        Visibility="{x:Bind ConfirmByHashVisibility}" />
                                <Button Grid.Column="3"
                                        Click="OnDeleteGroupClick">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon FontFamily="{StaticResource ArborynIconFontFamily}"
                                                  Glyph="&#xE74D;" FontSize="12" />
                                        <TextBlock Text="Supprimer la sélection" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <ItemsControl ItemsSource="{x:Bind Members}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:DuplicateMemberItem">
                                        <CheckBox IsChecked="{x:Bind ShouldDelete, Mode=TwoWay}"
                                                  Content="{x:Bind Label, Mode=OneWay}"
                                                  Margin="16,0,0,0"
                                                  MinWidth="0" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>
    </Grid>
</Page>
