<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Arboryn.UI.Pages.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctrl="using:Arboryn.UI.Controls">
    <ScrollViewer>
        <StackPanel Padding="32,24,32,32" Spacing="24" MaxWidth="1200">
            <StackPanel Spacing="4">
                <TextBlock Text="Historique" Style="{StaticResource ArborynTitleText}"
                           Foreground="{ThemeResource ArborynTextPrimaryBrush}" />
                <TextBlock Text="Journal des opérations, undo par lot, rapports d'activité."
                           Style="{StaticResource ArborynBodyText}"
                           Foreground="{ThemeResource ArborynTextSecondaryBrush}" />
            </StackPanel>
            <ctrl:EmptyStateView
                Glyph="&#xE81C;"
                Title="Le journal est tenu, l'écran arrive bientôt"
                Message="Les opérations sont déjà tracées en base (table operations) et l'undo de la dernière suppression est disponible depuis la page Doublons. La timeline complète par jour, l'undo par lot rétroactif et les rapports d'activité sont prévus avec les opérations cross-volume."
                Milestone="En base depuis l'incrément 1 — vue complète prévue avec Inc 10" />
        </StackPanel>
    </ScrollViewer>
</Page>
