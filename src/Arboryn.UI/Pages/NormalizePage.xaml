<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Arboryn.UI.Pages.NormalizePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctrl="using:Arboryn.UI.Controls">
    <ScrollViewer>
        <StackPanel Padding="32,24,32,32" Spacing="24" MaxWidth="1200">
            <StackPanel Spacing="4">
                <TextBlock Text="Uniformisation" Style="{StaticResource ArborynTitleText}"
                           Foreground="{ThemeResource ArborynTextPrimaryBrush}" />
                <TextBlock Text="Faire converger l'arborescence vers les chemins canoniques par catégorie."
                           Style="{StaticResource ArborynBodyText}"
                           Foreground="{ThemeResource ArborynTextSecondaryBrush}" />
            </StackPanel>
            <ctrl:EmptyStateView
                Glyph="&#xE8AC;"
                Title="L'uniformisation n'est pas encore activée"
                Message="Le moteur de templates Scriban, l'aperçu en lot Avant→Après et la gestion de conflits arrivent à l'incrément 6, une fois les métadonnées locales et la taxonomie canonique en place."
                Milestone="Incrément 6 — Taxonomie canonique + uniformisation" />
        </StackPanel>
    </ScrollViewer>
</Page>
