<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Arboryn.UI.Pages.NormalizePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:vm="using:Arboryn.UI.ViewModels">

    <Grid Padding="32,24,32,16" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Head -->
        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Text="Uniformisation" Style="{StaticResource ArborynTitleText}"
                       Foreground="{ThemeResource ArborynTextPrimaryBrush}" />
            <TextBlock Text="Faire converger l'arborescence vers les chemins canoniques par catégorie."
                       Style="{StaticResource ArborynBodyText}"
                       Foreground="{ThemeResource ArborynTextSecondaryBrush}" />
        </StackPanel>

        <!-- Folder + actions -->
        <StackPanel Grid.Row="1" Spacing="8">
            <muxc:ProgressBar IsIndeterminate="True"
                              Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0"
                        Background="{ThemeResource ArborynCardSecondaryBrush}"
                        CornerRadius="{StaticResource ArborynRadiusCard}"
                        BorderBrush="{ThemeResource ArborynStrokeCardBrush}"
                        BorderThickness="1" Padding="12,8" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <FontIcon FontFamily="{StaticResource ArborynIconFontFamily}"
                                  Glyph="&#xF12B;" FontSize="14"
                                  Foreground="{ThemeResource ArborynTextSecondaryBrush}" />
                        <TextBlock Text="Dossier (racine de bibliothèque) :"
                                   Style="{StaticResource ArborynCaptionText}"
                                   Foreground="{ThemeResource ArborynTextSecondaryBrush}"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{x:Bind ViewModel.CurrentFolder, Mode=OneWay}"
                                   Style="{StaticResource ArborynBodyText}"
                                   Foreground="{ThemeResource ArborynTextPrimaryBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTipService.ToolTip="{x:Bind ViewModel.CurrentFolder, Mode=OneWay}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Content="Choisir un dossier…" Click="OnPickFolderClick"
                            IsEnabled="{x:Bind ViewModel.CanUndo, Mode=OneWay}" />
                    <Button Content="Aperçu" Click="OnPlanClick"
                            IsEnabled="{x:Bind ViewModel.CanPlan, Mode=OneWay}" />
                    <Button Content="Uniformiser" Click="OnExecuteClick"
                            Style="{StaticResource AccentButtonStyle}"
                            IsEnabled="{x:Bind ViewModel.CanExecute, Mode=OneWay}" />
                </StackPanel>
            </Grid>

            <Border Background="{ThemeResource ArborynCautionBgBrush}"
                    CornerRadius="{StaticResource ArborynRadiusCard}" Padding="12,8">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <FontIcon FontFamily="{StaticResource ArborynIconFontFamily}"
                              Glyph="&#xE7BA;" FontSize="14"
                              Foreground="{ThemeResource ArborynCautionBrush}" />
                    <TextBlock Text="Les déplacements et renommages sont entièrement réversibles : « Annuler la dernière uniformisation » remet chaque fichier à sa place."
                               Style="{StaticResource ArborynCaptionText}"
                               Foreground="{ThemeResource ArborynCautionBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Undo + status -->
        <Grid Grid.Row="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                       Style="{StaticResource ArborynBodyText}"
                       Foreground="{ThemeResource ArborynTextSecondaryBrush}"
                       VerticalAlignment="Center" TextWrapping="Wrap" />
            <Button Grid.Column="1" Click="OnUndoClick"
                    IsEnabled="{x:Bind ViewModel.CanUndo, Mode=OneWay}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon FontFamily="{StaticResource ArborynIconFontFamily}"
                              Glyph="&#xE7A7;" FontSize="12" />
                    <TextBlock Text="Annuler la dernière uniformisation" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Preview header + global selection -->
        <Grid Grid.Row="3" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <CheckBox Grid.Column="0" Content="Tout sélectionner"
                      IsChecked="{x:Bind ViewModel.AllSelected, Mode=OneWay}"
                      Click="OnSelectAllClick"
                      Visibility="{x:Bind ViewModel.HasOperations, Mode=OneWay}" />
            <TextBlock Grid.Column="1"
                       Text="Aperçu Avant → Après"
                       VerticalAlignment="Center"
                       Style="{StaticResource ArborynCaptionText}"
                       Foreground="{ThemeResource ArborynTextSecondaryBrush}" />
            <TextBlock Grid.Column="2"
                       Text="{x:Bind ViewModel.SelectionSummary, Mode=OneWay}"
                       VerticalAlignment="Center"
                       Visibility="{x:Bind ViewModel.HasOperations, Mode=OneWay}"
                       Style="{StaticResource ArborynCaptionText}"
                       Foreground="{ThemeResource ArborynTextSecondaryBrush}" />
        </Grid>

        <!-- Preview list -->
        <Border Grid.Row="4" Style="{StaticResource ArborynCardBorder}" Padding="0">
            <ListView ItemsSource="{x:Bind ViewModel.Operations, Mode=OneWay}"
                      SelectionMode="None" Background="Transparent">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Padding" Value="16,10" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:PlannedOperationItem">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <CheckBox Grid.Column="0" MinWidth="0" VerticalAlignment="Center"
                                      IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                      ToolTipService.ToolTip="Inclure cette opération" />
                            <Border Grid.Column="1"
                                    Background="{ThemeResource ArborynAccentSelectedBgBrush}"
                                    CornerRadius="{StaticResource ArborynRadiusPill}"
                                    Padding="10,3" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind KindLabel}" FontSize="11"
                                           Foreground="{ThemeResource ArborynAccentTextBrush}" />
                            </Border>
                            <StackPanel Grid.Column="2" Spacing="2">
                                <TextBlock Text="{x:Bind OldPath}"
                                           Style="{StaticResource ArborynCaptionText}"
                                           Foreground="{ThemeResource ArborynTextSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis" />
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon FontFamily="{StaticResource ArborynIconFontFamily}"
                                              Glyph="&#xE74A;" FontSize="11"
                                              Foreground="{ThemeResource ArborynAccentTextBrush}"
                                              VerticalAlignment="Center" />
                                    <TextBlock Text="{x:Bind NewRelativePath}"
                                               Style="{StaticResource ArborynBodyStrongText}"
                                               Foreground="{ThemeResource ArborynTextPrimaryBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>
    </Grid>
</Page>
