<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Arboryn.UI.Pages.PlacementPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:vm="using:Arboryn.UI.ViewModels">

    <Grid Padding="32,24,32,16" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Head -->
        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock Text="Plan de placement" Style="{StaticResource ArborynTitleText}"
                           Foreground="{ThemeResource ArborynTextPrimaryBrush}" />
                <TextBlock Text="Faire converger chaque volume vers son contenu cible (périmètre de réplication)."
                           Style="{StaticResource ArborynBodyText}"
                           Foreground="{ThemeResource ArborynTextSecondaryBrush}" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Content="Générer le plan" Click="OnGenerateClick"
                        Style="{StaticResource AccentButtonStyle}"
                        IsEnabled="{x:Bind ViewModel.CanGenerate, Mode=OneWay}" />
                <Button Content="Exécuter la sélection" Click="OnExecuteClick"
                        IsEnabled="{x:Bind ViewModel.CanExecute, Mode=OneWay}" />
                <Button Content="Annuler le dernier lot" Click="OnUndoClick"
                        IsEnabled="{x:Bind ViewModel.CanUndo, Mode=OneWay}" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1" Spacing="6">
            <muxc:ProgressBar IsIndeterminate="True" Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
            <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                       Style="{StaticResource ArborynBodyText}"
                       Foreground="{ThemeResource ArborynTextSecondaryBrush}" TextWrapping="Wrap" />
        </StackPanel>

        <!-- Per-volume summary -->
        <ItemsControl Grid.Row="2" ItemsSource="{x:Bind ViewModel.VolumeSummaries, Mode=OneWay}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <muxc:ItemsWrapGrid Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:PlacementVolumeSummary">
                    <Border Style="{StaticResource ArborynSecondaryCardBorder}" Margin="0,0,10,10" MinWidth="240">
                        <StackPanel Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{x:Bind Name}" Style="{StaticResource ArborynBodyStrongText}"
                                           Foreground="{ThemeResource ArborynTextPrimaryBrush}" />
                                <Border Style="{StaticResource ArborynBadgeBorder}">
                                    <TextBlock Text="{x:Bind SpaceText}" FontSize="11"
                                               Foreground="{ThemeResource ArborynTextSecondaryBrush}" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{x:Bind Detail}" Style="{StaticResource ArborynCaptionText}"
                                       Foreground="{ThemeResource ArborynTextSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Conflicts -->
        <Border Grid.Row="3" Background="{ThemeResource ArborynCautionBgBrush}"
                CornerRadius="{StaticResource ArborynRadiusCard}" Padding="14,10" Margin="0,0,0,0"
                Visibility="{x:Bind ViewModel.HasConflicts, Mode=OneWay}">
            <StackPanel Spacing="6">
                <TextBlock Text="Conflits de version (à résoudre manuellement)"
                           Style="{StaticResource ArborynBodyStrongText}"
                           Foreground="{ThemeResource ArborynCautionBrush}" />
                <ItemsControl ItemsSource="{x:Bind ViewModel.Conflicts, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:PlacementConflictRow">
                            <TextBlock Style="{StaticResource ArborynCaptionText}"
                                       Foreground="{ThemeResource ArborynTextPrimaryBrush}" TextWrapping="Wrap">
                                <Run Text="{x:Bind Description}" />
                                <Run Text=" — volumes :" />
                                <Run Text="{x:Bind Volumes}" />
                            </TextBlock>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- Operations -->
        <Border Grid.Row="4" Style="{StaticResource ArborynCardBorder}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="{x:Bind ViewModel.SelectionSummary, Mode=OneWay}"
                           Style="{StaticResource ArborynCaptionText}" Padding="16,12,16,4"
                           Foreground="{ThemeResource ArborynTextSecondaryBrush}" />
                <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Operations, Mode=OneWay}"
                          SelectionMode="None" Background="Transparent">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Padding" Value="12,6" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:PlacementOperationRow">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0" MinWidth="0"
                                          IsChecked="{x:Bind IsSelected, Mode=TwoWay}" />
                                <Border Grid.Column="1" Style="{StaticResource ArborynBadgeBorder}" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind KindLabel}" FontSize="11"
                                               Foreground="{ThemeResource ArborynTextSecondaryBrush}" />
                                </Border>
                                <TextBlock Grid.Column="2" Text="{x:Bind VolumeLabel}" VerticalAlignment="Center"
                                           Style="{StaticResource ArborynCaptionText}"
                                           Foreground="{ThemeResource ArborynTextSecondaryBrush}" />
                                <TextBlock Grid.Column="3" Text="{x:Bind PathLabel}" VerticalAlignment="Center"
                                           Style="{StaticResource ArborynCaptionText}"
                                           Foreground="{ThemeResource ArborynTextPrimaryBrush}"
                                           TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>
    </Grid>
</Page>
