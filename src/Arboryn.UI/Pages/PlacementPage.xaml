<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Arboryn.UI.Pages.PlacementPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctrl="using:Arboryn.UI.Controls">
    <ScrollViewer>
        <StackPanel Padding="32,24,32,32" Spacing="24" MaxWidth="1200">
            <StackPanel Spacing="4">
                <TextBlock Text="Plan de placement" Style="{StaticResource ArborynTitleText}"
                           Foreground="{ThemeResource ArborynTextPrimaryBrush}" />
                <TextBlock Text="Faire converger chaque volume vers son contenu cible (ReplicationScope)."
                           Style="{StaticResource ArborynBodyText}"
                           Foreground="{ThemeResource ArborynTextSecondaryBrush}" />
            </StackPanel>
            <ctrl:EmptyStateView
                Glyph="&#xE8CE;"
                Title="Le moteur de réplication n'est pas encore activé"
                Message="La synthèse par volume (entrées / sorties / différé), la détection de conflits inter-volumes et l'exécution batch avec reprise au branchement arrivent à l'incrément 10. Le multi-volume (Inc 9) est un prérequis."
                Milestone="Incrément 10 — Moteur de réplication multi-support" />
        </StackPanel>
    </ScrollViewer>
</Page>
