<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Arboryn.UI.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Arboryn.UI.ViewModels">

    <ScrollViewer>
        <StackPanel Padding="32,24,32,32" Spacing="24" MaxWidth="960">

            <StackPanel Spacing="4">
                <TextBlock Text="Réglages" Style="{StaticResource ArborynTitleText}"
                           Foreground="{ThemeResource ArborynTextPrimaryBrush}" />
                <TextBlock Text="Arboryn 2.4.0 · base de catalogue locale · 1 volume (default)"
                           Style="{StaticResource ArborynBodyText}"
                           Foreground="{ThemeResource ArborynTextSecondaryBrush}" />
            </StackPanel>

            <!-- Section : Volumes & scan -->
            <Border Style="{StaticResource ArborynCardBorder}">
                <StackPanel Spacing="16">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon FontFamily="{StaticResource ArborynIconFontFamily}"
                                  Glyph="&#xE895;" FontSize="18" />
                        <TextBlock Text="Volumes &amp; scan"
                                   Style="{StaticResource ArborynBodyStrongText}"
                                   Foreground="{ThemeResource ArborynTextPrimaryBrush}" />
                    </StackPanel>

                    <!-- prefer_deeper -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="Préférer l'exemplaire le plus profond"
                                       Style="{StaticResource ArborynBodyStrongText}"
                                       Foreground="{ThemeResource ArborynTextPrimaryBrush}" />
                            <TextBlock Text="À taille égale, la copie située dans l'arborescence la plus profonde (chemin canonique probable) est sélectionnée par défaut."
                                       Style="{StaticResource ArborynCaptionText}"
                                       Foreground="{ThemeResource ArborynTextSecondaryBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" MinWidth="0"
                                      VerticalAlignment="Center"
                                      IsOn="{x:Bind ViewModel.PreferDeeper, Mode=TwoWay}" />
                    </Grid>

                    <Border Background="{ThemeResource ArborynStrokeDividerBrush}" Height="1" />

                    <!-- Priority directories -->
                    <StackPanel Spacing="12">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Dossiers prioritaires"
                                       Style="{StaticResource ArborynBodyStrongText}"
                                       Foreground="{ThemeResource ArborynTextPrimaryBrush}" />
                            <TextBlock Text="Quand un même fichier est présent à plusieurs endroits, la version située dans un de ces dossiers est conservée. L'ordre est important : du plus prioritaire au moins. Astuce : un motif comme C:\Livres\* favorise tout le sous-arbre d'un coup, et C:\Users\*\Documents s'applique à tout utilisateur."
                                       Style="{StaticResource ArborynCaptionText}"
                                       Foreground="{ThemeResource ArborynTextSecondaryBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <Border Background="{ThemeResource ArborynCardSecondaryBrush}"
                                BorderBrush="{ThemeResource ArborynStrokeCardBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource ArborynRadiusCard}"
                                Padding="0">
                            <ListView ItemsSource="{x:Bind ViewModel.PriorityDirectories, Mode=OneWay}"
                                      SelectionMode="None"
                                      Background="Transparent"
                                      MaxHeight="220">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="Padding" Value="12,6" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <Grid ColumnSpacing="6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0"
                                                    Style="{StaticResource ArborynSubtleButton}"
                                                    Click="OnPriorityUpClick"
                                                    Padding="6,2"
                                                    ToolTipService.ToolTip="Monter">
                                                <FontIcon FontFamily="{StaticResource ArborynIconFontFamily}"
                                                          Glyph="&#xE70E;" FontSize="10" />
                                            </Button>
                                            <Button Grid.Column="1"
                                                    Style="{StaticResource ArborynSubtleButton}"
                                                    Click="OnPriorityDownClick"
                                                    Padding="6,2"
                                                    ToolTipService.ToolTip="Descendre">
                                                <FontIcon FontFamily="{StaticResource ArborynIconFontFamily}"
                                                          Glyph="&#xE70D;" FontSize="10" />
                                            </Button>
                                            <Button Grid.Column="2"
                                                    Style="{StaticResource ArborynSubtleButton}"
                                                    Click="OnPriorityRemoveClick"
                                                    Padding="6,2"
                                                    ToolTipService.ToolTip="Retirer">
                                                <FontIcon FontFamily="{StaticResource ArborynIconFontFamily}"
                                                          Glyph="&#xE711;" FontSize="10" />
                                            </Button>
                                            <TextBlock Grid.Column="3"
                                                       Text="{x:Bind}"
                                                       Style="{StaticResource ArborynBodyText}"
                                                       Foreground="{ThemeResource ArborynTextPrimaryBrush}"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="8,0,0,0" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Border>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Click="OnAddPriorityFolderClick">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon FontFamily="{StaticResource ArborynIconFontFamily}"
                                              Glyph="&#xE710;" FontSize="12" />
                                    <TextBlock Text="Ajouter un dossier…" />
                                </StackPanel>
                            </Button>
                            <TextBlock Text="ou suggestion :"
                                       Style="{StaticResource ArborynCaptionText}"
                                       Foreground="{ThemeResource ArborynTextSecondaryBrush}"
                                       VerticalAlignment="Center" />
                            <ComboBox x:Name="SuggestionsCombo" MinWidth="280"
                                      ItemsSource="{x:Bind ViewModel.SuggestedDirectories, Mode=OneWay}" />
                            <Button Content="Ajouter" Click="OnAddSuggestionClick" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBox x:Name="PriorityPatternBox" MinWidth="360"
                                     PlaceholderText="ou un motif : C:\Livres\*"
                                     KeyDown="OnPriorityPatternKeyDown" />
                            <Button Content="Ajouter le motif" Click="OnAddPriorityPatternClick" />
                        </StackPanel>
                    </StackPanel>

                    <Border Background="{ThemeResource ArborynStrokeDividerBrush}" Height="1" />

                    <!-- Excluded directories -->
                    <StackPanel Spacing="12">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Dossiers à écarter"
                                       Style="{StaticResource ArborynBodyStrongText}"
                                       Foreground="{ThemeResource ArborynTextPrimaryBrush}" />
                            <TextBlock Text="Quand un même fichier existe ailleurs, la copie située dans un de ces dossiers est écartée par défaut (cochée pour suppression). Idéal pour un dossier « Téléchargements » dont le contenu est déjà rangé. Motifs génériques acceptés (C:\…\Downloads\*, C:\Users\*\Downloads)."
                                       Style="{StaticResource ArborynCaptionText}"
                                       Foreground="{ThemeResource ArborynTextSecondaryBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <Border Background="{ThemeResource ArborynCardSecondaryBrush}"
                                BorderBrush="{ThemeResource ArborynStrokeCardBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource ArborynRadiusCard}"
                                Padding="0">
                            <ListView ItemsSource="{x:Bind ViewModel.ExcludedDirectories, Mode=OneWay}"
                                      SelectionMode="None"
                                      Background="Transparent"
                                      MaxHeight="180">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="Padding" Value="12,6" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <Grid ColumnSpacing="6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0"
                                                    Style="{StaticResource ArborynSubtleButton}"
                                                    Click="OnExcludeRemoveClick"
                                                    Padding="6,2"
                                                    ToolTipService.ToolTip="Retirer">
                                                <FontIcon FontFamily="{StaticResource ArborynIconFontFamily}"
                                                          Glyph="&#xE711;" FontSize="10" />
                                            </Button>
                                            <TextBlock Grid.Column="1"
                                                       Text="{x:Bind}"
                                                       Style="{StaticResource ArborynBodyText}"
                                                       Foreground="{ThemeResource ArborynTextPrimaryBrush}"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="8,0,0,0" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Border>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Click="OnAddExcludeFolderClick">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon FontFamily="{StaticResource ArborynIconFontFamily}"
                                              Glyph="&#xE710;" FontSize="12" />
                                    <TextBlock Text="Ajouter un dossier…" />
                                </StackPanel>
                            </Button>
                            <TextBox x:Name="ExcludePatternBox" MinWidth="320"
                                     PlaceholderText="ou un motif : C:\Users\*\Downloads"
                                     KeyDown="OnExcludePatternKeyDown" />
                            <Button Content="Ajouter le motif" Click="OnAddExcludePatternClick" />
                        </StackPanel>
                    </StackPanel>

                    <Border Background="{ThemeResource ArborynStrokeDividerBrush}" Height="1" />

                    <!-- Maintenance -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="Vider le catalogue"
                                       Style="{StaticResource ArborynBodyStrongText}"
                                       Foreground="{ThemeResource ArborynTextPrimaryBrush}" />
                            <TextBlock Text="Supprime toutes les FileInstances et LogicalFiles de la base de données. Les fichiers sur disque ne sont pas touchés. Utile après un changement majeur de structure."
                                       Style="{StaticResource ArborynCaptionText}"
                                       Foreground="{ThemeResource ArborynTextSecondaryBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="1" Click="OnClearCatalogClick"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontFamily="{StaticResource ArborynIconFontFamily}"
                                          Glyph="&#xE74D;" FontSize="12" />
                                <TextBlock Text="Vider…" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Section : Enrichissement en ligne (Inc 8) -->
            <Border Style="{StaticResource ArborynCardBorder}">
                <StackPanel Spacing="16">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon FontFamily="{StaticResource ArborynIconFontFamily}"
                                  Glyph="&#xE774;" FontSize="18" />
                        <TextBlock Text="Enrichissement en ligne"
                                   Style="{StaticResource ArborynBodyStrongText}"
                                   Foreground="{ThemeResource ArborynTextPrimaryBrush}" />
                    </StackPanel>

                    <Border Background="{ThemeResource ArborynCautionBgBrush}"
                            CornerRadius="{StaticResource ArborynRadiusCard}" Padding="12,8">
                        <TextBlock Text="Privacy-first : seuls des champs structurés (titre, auteur, ISBN, année) sont envoyés aux providers. Jamais le nom de fichier ni le chemin. En mode local (par défaut), aucune requête réseau."
                                   Style="{StaticResource ArborynCaptionText}"
                                   Foreground="{ThemeResource ArborynCautionBrush}"
                                   TextWrapping="Wrap" />
                    </Border>

                    <!-- Global toggle -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="Activer l'enrichissement en ligne"
                                       Style="{StaticResource ArborynBodyStrongText}"
                                       Foreground="{ThemeResource ArborynTextPrimaryBrush}" />
                            <TextBlock Text="Interrupteur maître. Désactivé = 100 % local, aucune sortie réseau."
                                       Style="{StaticResource ArborynCaptionText}"
                                       Foreground="{ThemeResource ArborynTextSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" MinWidth="0" VerticalAlignment="Center"
                                      IsOn="{x:Bind Enrichment.OnlineModeEnabled, Mode=TwoWay}" />
                    </Grid>

                    <Border Background="{ThemeResource ArborynStrokeDividerBrush}" Height="1" />

                    <!-- Per-category toggles -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="Catégories enrichies"
                                   Style="{StaticResource ArborynBodyStrongText}"
                                   Foreground="{ThemeResource ArborynTextPrimaryBrush}" />
                        <StackPanel Orientation="Horizontal" Spacing="20">
                            <CheckBox Content="Livres" IsChecked="{x:Bind Enrichment.EnrichBooks, Mode=TwoWay}" />
                            <CheckBox Content="Livres audio" IsChecked="{x:Bind Enrichment.EnrichAudiobooks, Mode=TwoWay}" />
                            <CheckBox Content="Vidéos" IsChecked="{x:Bind Enrichment.EnrichVideos, Mode=TwoWay}" />
                            <CheckBox Content="BD" IsChecked="{x:Bind Enrichment.EnrichComics, Mode=TwoWay}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Confidence threshold -->
                    <StackPanel Spacing="2">
                        <TextBlock Text="Seuil d'auto-application de la confiance"
                                   Style="{StaticResource ArborynBodyStrongText}"
                                   Foreground="{ThemeResource ArborynTextPrimaryBrush}" />
                        <TextBlock Text="Au-dessus du seuil, les champs trouvés sont appliqués automatiquement ; en dessous, ils sont proposés."
                                   Style="{StaticResource ArborynCaptionText}"
                                   Foreground="{ThemeResource ArborynTextSecondaryBrush}" TextWrapping="Wrap" />
                        <Slider Minimum="0" Maximum="1" StepFrequency="0.05" Width="300"
                                HorizontalAlignment="Left"
                                Value="{x:Bind Enrichment.ConfidenceThreshold, Mode=TwoWay}" />
                    </StackPanel>

                    <!-- Enrich during scan -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="Enrichir automatiquement pendant le scan"
                                       Style="{StaticResource ArborynBodyStrongText}"
                                       Foreground="{ThemeResource ArborynTextPrimaryBrush}" />
                            <TextBlock Text="À la fin d'un scan, les fichiers indexés sont enrichis (si le mode en ligne est actif)."
                                       Style="{StaticResource ArborynCaptionText}"
                                       Foreground="{ThemeResource ArborynTextSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" MinWidth="0" VerticalAlignment="Center"
                                      IsOn="{x:Bind Enrichment.EnrichDuringScan, Mode=TwoWay}" />
                    </Grid>

                    <Border Background="{ThemeResource ArborynStrokeDividerBrush}" Height="1" />

                    <!-- API keys -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="Clés d'API"
                                   Style="{StaticResource ArborynBodyStrongText}"
                                   Foreground="{ThemeResource ArborynTextPrimaryBrush}" />
                        <TextBlock Text="TMDB requiert une clé (vidéos). Google Books fonctionne sans clé (quota anonyme) ; une clé augmente le quota. OpenLibrary et MusicBrainz ne requièrent pas de clé."
                                   Style="{StaticResource ArborynCaptionText}"
                                   Foreground="{ThemeResource ArborynTextSecondaryBrush}" TextWrapping="Wrap" />
                        <Grid ColumnSpacing="12" RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="TMDB" VerticalAlignment="Center"
                                       Foreground="{ThemeResource ArborynTextSecondaryBrush}" />
                            <PasswordBox Grid.Row="0" Grid.Column="1"
                                         Password="{x:Bind Enrichment.TmdbApiKey, Mode=TwoWay}" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Google Books" VerticalAlignment="Center"
                                       Foreground="{ThemeResource ArborynTextSecondaryBrush}" />
                            <PasswordBox Grid.Row="1" Grid.Column="1"
                                         Password="{x:Bind Enrichment.GoogleBooksApiKey, Mode=TwoWay}" />
                        </Grid>
                    </StackPanel>

                    <Border Background="{ThemeResource ArborynStrokeDividerBrush}" Height="1" />

                    <!-- Actions -->
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Enregistrer les réglages" Click="OnSaveEnrichmentClick"
                                    Style="{StaticResource AccentButtonStyle}"
                                    IsEnabled="{x:Bind Enrichment.CanRun, Mode=OneWay}" />
                            <Button Content="Enrichir le catalogue" Click="OnEnrichCatalogClick"
                                    IsEnabled="{x:Bind Enrichment.CanRun, Mode=OneWay}" />
                            <Button Content="Enrichir un dossier…" Click="OnEnrichFolderClick"
                                    IsEnabled="{x:Bind Enrichment.CanRun, Mode=OneWay}" />
                        </StackPanel>
                        <TextBlock Text="{x:Bind Enrichment.StatusText, Mode=OneWay}"
                                   Style="{StaticResource ArborynCaptionText}"
                                   Foreground="{ThemeResource ArborynTextSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Section : Avancé -->
            <Border Style="{StaticResource ArborynCardBorder}">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon FontFamily="{StaticResource ArborynIconFontFamily}"
                                  Glyph="&#xE8EC;" FontSize="18" />
                        <TextBlock Text="Avancé"
                                   Style="{StaticResource ArborynBodyStrongText}"
                                   Foreground="{ThemeResource ArborynTextPrimaryBrush}" />
                    </StackPanel>

                    <StackPanel Spacing="8">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Emplacement de la base de données"
                                       Style="{StaticResource ArborynBodyStrongText}"
                                       Foreground="{ThemeResource ArborynTextPrimaryBrush}" />
                            <TextBlock Text="Placez la base sur une clé USB ou un dossier partagé pour la transporter d'un PC à l'autre. Le partage se fait par Export/Import sûrs — n'ouvrez jamais la base en direct depuis deux PC à la fois."
                                       Style="{StaticResource ArborynCaptionText}"
                                       Foreground="{ThemeResource ArborynTextSecondaryBrush}" TextWrapping="Wrap" />
                            <TextBlock Text="{x:Bind Database.DatabasePath, Mode=OneWay}"
                                       FontFamily="{StaticResource ArborynMonoFontFamily}"
                                       Style="{StaticResource ArborynCaptionText}"
                                       Foreground="{ThemeResource ArborynTextSecondaryBrush}"
                                       IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                        </StackPanel>

                        <InfoBar IsOpen="{x:Bind Database.IsRiskyLocation, Mode=OneWay}"
                                 IsClosable="False" Severity="Warning"
                                 Title="Emplacement synchronisé / réseau / amovible"
                                 Message="Fermez Arboryn avant toute synchronisation cloud, et n'ouvrez pas la base depuis deux PC simultanément — risque de corruption." />

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Click="OnChooseDbLocationClick">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon FontFamily="{StaticResource ArborynIconFontFamily}"
                                              Glyph="&#xE8DA;" FontSize="12" />
                                    <TextBlock Text="Choisir un emplacement…" />
                                </StackPanel>
                            </Button>
                            <Button Content="Réinitialiser (local)" Click="OnResetDbLocationClick" />
                            <Button Click="OnExportDbClick">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon FontFamily="{StaticResource ArborynIconFontFamily}"
                                              Glyph="&#xEDE1;" FontSize="12" />
                                    <TextBlock Text="Exporter…" />
                                </StackPanel>
                            </Button>
                            <Button Click="OnImportDbClick">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon FontFamily="{StaticResource ArborynIconFontFamily}"
                                              Glyph="&#xE896;" FontSize="12" />
                                    <TextBlock Text="Importer…" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <TextBlock Text="{x:Bind Database.StatusText, Mode=OneWay}"
                                   Style="{StaticResource ArborynCaptionText}"
                                   Foreground="{ThemeResource ArborynAccentTextBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="Journal d'application"
                                   Style="{StaticResource ArborynBodyStrongText}"
                                   Foreground="{ThemeResource ArborynTextPrimaryBrush}" />
                        <TextBlock Text="%LOCALAPPDATA%\Arboryn\logs\Arboryn-YYYYMMDD.log"
                                   FontFamily="{StaticResource ArborynMonoFontFamily}"
                                   Style="{StaticResource ArborynCaptionText}"
                                   Foreground="{ThemeResource ArborynTextSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
