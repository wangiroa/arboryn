<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Arboryn.UI.Pages.TaxonomyPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctrl="using:Arboryn.UI.Controls">
    <ScrollViewer>
        <StackPanel Padding="32,24,32,32" Spacing="24" MaxWidth="1200">
            <StackPanel Spacing="4">
                <TextBlock Text="Taxonomie" Style="{StaticResource ArborynTitleText}"
                           Foreground="{ThemeResource ArborynTextPrimaryBrush}" />
                <TextBlock Text="Templates de chemin et de nom canoniques par catégorie."
                           Style="{StaticResource ArborynBodyText}"
                           Foreground="{ThemeResource ArborynTextSecondaryBrush}" />
            </StackPanel>
            <ctrl:EmptyStateView
                Glyph="&#xE8EC;"
                Title="L'éditeur de taxonomie n'est pas encore disponible"
                Message="L'éditeur Scriban avec autocomplétion des variables, l'aperçu live sur LogicalFiles réels, le versioning des templates et la gestion des sous-catégories arrivent à l'incrément 6."
                Milestone="Incrément 6 — Taxonomie canonique + uniformisation" />
        </StackPanel>
    </ScrollViewer>
</Page>
