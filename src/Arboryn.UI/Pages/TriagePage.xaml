<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Arboryn.UI.Pages.TriagePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:vm="using:Arboryn.UI.ViewModels">

    <Grid Padding="32,24,32,16" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Head -->
        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Text="Triage" Style="{StaticResource ArborynTitleText}"
                       Foreground="{ThemeResource ArborynTextPrimaryBrush}" />
            <TextBlock Text="Catégorisation rapide des documents officiels : source, objet, date — pré-remplis automatiquement."
                       Style="{StaticResource ArborynBodyText}"
                       Foreground="{ThemeResource ArborynTextSecondaryBrush}" />
        </StackPanel>

        <!-- Folder + actions -->
        <StackPanel Grid.Row="1" Spacing="8">
            <muxc:ProgressBar IsIndeterminate="True"
                              Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0"
                        Background="{ThemeResource ArborynCardSecondaryBrush}"
                        CornerRadius="{StaticResource ArborynRadiusCard}"
                        BorderBrush="{ThemeResource ArborynStrokeCardBrush}"
                        BorderThickness="1" Padding="12,8" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <FontIcon FontFamily="{StaticResource ArborynIconFontFamily}"
                                  Glyph="&#xF12B;" FontSize="14"
                                  Foreground="{ThemeResource ArborynTextSecondaryBrush}" />
                        <TextBlock Text="Dossier de documents :"
                                   Style="{StaticResource ArborynCaptionText}"
                                   Foreground="{ThemeResource ArborynTextSecondaryBrush}"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{x:Bind ViewModel.CurrentFolder, Mode=OneWay}"
                                   Style="{StaticResource ArborynBodyText}"
                                   Foreground="{ThemeResource ArborynTextPrimaryBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTipService.ToolTip="{x:Bind ViewModel.CurrentFolder, Mode=OneWay}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Content="Choisir un dossier…" Click="OnPickFolderClick"
                            IsEnabled="{x:Bind ViewModel.CanUndo, Mode=OneWay}" />
                    <Button Content="Préparer" Click="OnPrepareClick"
                            IsEnabled="{x:Bind ViewModel.CanPrepare, Mode=OneWay}" />
                    <Button Content="Appliquer" Click="OnApplyClick"
                            Style="{StaticResource AccentButtonStyle}"
                            IsEnabled="{x:Bind ViewModel.CanApply, Mode=OneWay}" />
                </StackPanel>
            </Grid>
        </StackPanel>

        <!-- Undo + status -->
        <Grid Grid.Row="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                       Style="{StaticResource ArborynBodyText}"
                       Foreground="{ThemeResource ArborynTextSecondaryBrush}"
                       VerticalAlignment="Center" TextWrapping="Wrap" />
            <Button Grid.Column="1" Click="OnUndoClick"
                    IsEnabled="{x:Bind ViewModel.CanUndo, Mode=OneWay}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon FontFamily="{StaticResource ArborynIconFontFamily}"
                              Glyph="&#xE7A7;" FontSize="12" />
                    <TextBlock Text="Annuler le dernier lot" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Triage grid -->
        <Border Grid.Row="3" Style="{StaticResource ArborynCardBorder}" Padding="0">
            <ListView ItemsSource="{x:Bind ViewModel.Rows, Mode=OneWay}"
                      SelectionMode="None" Background="Transparent">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Padding" Value="14,12" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:TriageRowItem">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Thumbnail / glyph -->
                            <Border Grid.Column="0" Width="92" Height="120"
                                    Background="{ThemeResource ArborynCardSecondaryBrush}"
                                    CornerRadius="{StaticResource ArborynRadiusCard}"
                                    BorderBrush="{ThemeResource ArborynStrokeCardBrush}"
                                    BorderThickness="1">
                                <Grid>
                                    <Image Source="{x:Bind Thumbnail}" Stretch="UniformToFill"
                                           Visibility="{x:Bind ThumbnailVisibility}" />
                                    <FontIcon FontFamily="{StaticResource ArborynIconFontFamily}"
                                              Glyph="&#xE8A5;" FontSize="28"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Foreground="{ThemeResource ArborynTextSecondaryBrush}"
                                              Visibility="{x:Bind GlyphVisibility}" />
                                </Grid>
                            </Border>

                            <!-- Filename + snippet + fields -->
                            <StackPanel Grid.Column="1" Spacing="8">
                                <TextBlock Text="{x:Bind FileName}"
                                           Style="{StaticResource ArborynBodyStrongText}"
                                           Foreground="{ThemeResource ArborynTextPrimaryBrush}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind Snippet}"
                                           Style="{StaticResource ArborynCaptionText}"
                                           Foreground="{ThemeResource ArborynTextSecondaryBrush}"
                                           TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                                <Grid ColumnSpacing="10" RowSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Header="Source" PlaceholderText="Émetteur"
                                             Text="{x:Bind Source, Mode=TwoWay}" />
                                    <TextBox Grid.Column="1" Header="Objet" PlaceholderText="Nature"
                                             Text="{x:Bind Object, Mode=TwoWay}" />
                                    <TextBox Grid.Column="2" Header="Date" PlaceholderText="AAAAMM" Width="110"
                                             Text="{x:Bind Date, Mode=TwoWay}" />
                                    <ComboBox Grid.Column="3" Header="Sous-catégorie" MinWidth="150"
                                              ItemsSource="{x:Bind Subcategories}"
                                              SelectedItem="{x:Bind Subcategory, Mode=TwoWay}" />
                                </Grid>
                            </StackPanel>

                            <!-- Validation -->
                            <CheckBox Grid.Column="2" Content="Validé" VerticalAlignment="Center"
                                      IsChecked="{x:Bind IsValidated, Mode=TwoWay}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>
    </Grid>
</Page>
