<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Arboryn.UI.Pages.VolumesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:vm="using:Arboryn.UI.ViewModels">

    <Grid Padding="32,24,32,16" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Head -->
        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Text="Volumes" Style="{StaticResource ArborynTitleText}"
                       Foreground="{ThemeResource ArborynTextPrimaryBrush}" />
            <TextBlock Text="Identifiez vos disques et NAS, et choisissez le volume actif sur lequel portent scan, doublons et uniformisation."
                       Style="{StaticResource ArborynBodyText}"
                       Foreground="{ThemeResource ArborynTextSecondaryBrush}" TextWrapping="Wrap" />
        </StackPanel>

        <!-- Actions -->
        <StackPanel Grid.Row="1" Spacing="8">
            <muxc:ProgressBar IsIndeterminate="True"
                              Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0"
                        Background="{ThemeResource ArborynCardSecondaryBrush}"
                        CornerRadius="{StaticResource ArborynRadiusCard}"
                        BorderBrush="{ThemeResource ArborynStrokeCardBrush}"
                        BorderThickness="1" Padding="12,8" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <FontIcon FontFamily="{StaticResource ArborynIconFontFamily}"
                                  Glyph="&#xE958;" FontSize="14"
                                  Foreground="{ThemeResource ArborynTextSecondaryBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.ActiveVolumeText, Mode=OneWay}"
                                   Style="{StaticResource ArborynBodyText}"
                                   Foreground="{ThemeResource ArborynTextPrimaryBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Content="Actualiser" Click="OnRefreshClick"
                            IsEnabled="{x:Bind ViewModel.CanInteract, Mode=OneWay}" />
                    <Button Content="Enrôler un dossier…" Click="OnEnrollClick"
                            Style="{StaticResource AccentButtonStyle}"
                            IsEnabled="{x:Bind ViewModel.CanInteract, Mode=OneWay}" />
                </StackPanel>
            </Grid>
            <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                       Style="{StaticResource ArborynCaptionText}"
                       Foreground="{ThemeResource ArborynTextSecondaryBrush}"
                       TextWrapping="Wrap" />
        </StackPanel>

        <TextBlock Grid.Row="2" Text="Volumes connus"
                   Style="{StaticResource ArborynCaptionText}"
                   Foreground="{ThemeResource ArborynTextSecondaryBrush}" />

        <!-- List -->
        <Border Grid.Row="3" Style="{StaticResource ArborynCardBorder}" Padding="0">
            <ListView ItemsSource="{x:Bind ViewModel.Volumes, Mode=OneWay}"
                      SelectionMode="None" Background="Transparent">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Padding" Value="16,12" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:VolumeRowItem">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Spacing="3">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{x:Bind Name}"
                                               Style="{StaticResource ArborynBodyStrongText}"
                                               Foreground="{ThemeResource ArborynTextPrimaryBrush}" />
                                    <Border Background="{ThemeResource ArborynAccentSelectedBgBrush}"
                                            CornerRadius="{StaticResource ArborynRadiusPill}"
                                            Padding="8,1" VerticalAlignment="Center"
                                            Visibility="{x:Bind IsActive, Mode=OneWay}">
                                        <TextBlock Text="Actif" FontSize="10"
                                                   Foreground="{ThemeResource ArborynAccentTextBrush}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Style="{StaticResource ArborynCaptionText}"
                                           Foreground="{ThemeResource ArborynTextSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis">
                                    <Run Text="{x:Bind KindLabel}" />
                                    <Run Text="·" />
                                    <Run Text="{x:Bind StatusLabel}" />
                                    <Run Text="·" />
                                    <Run Text="{x:Bind MountPoint}" />
                                    <Run Text="·" />
                                    <Run Text="{x:Bind Identity}" />
                                </TextBlock>
                                <TextBlock Style="{StaticResource ArborynCaptionText}"
                                           Foreground="{ThemeResource ArborynTextSecondaryBrush}">
                                    <Run Text="Dernier scan :" />
                                    <Run Text="{x:Bind LastScanText}" />
                                </TextBlock>
                            </StackPanel>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                                <TextBlock Text="{x:Bind SizeText}"
                                           Style="{StaticResource ArborynCaptionText}"
                                           Foreground="{ThemeResource ArborynTextSecondaryBrush}" />
                            </StackPanel>

                            <Button Grid.Column="2" Content="Rendre actif"
                                    VerticalAlignment="Center" Click="OnSetActiveClick" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>
    </Grid>
</Page>
