    <FontFamily x:Key="ArborynFontFamily">Segoe UI Variable Display, Segoe UI Variable, Segoe UI</FontFamily>
    <FontFamily x:Key="ArborynIconFontFamily">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <FontFamily x:Key="ArborynMonoFontFamily">Cascadia Code, Consolas, Courier New</FontFamily>

    <x:Double x:Key="ArborynSpacing1">4</x:Double>
    <x:Double x:Key="ArborynSpacing2">8</x:Double>
    <x:Double x:Key="ArborynSpacing3">12</x:Double>
    <x:Double x:Key="ArborynSpacing4">16</x:Double>
    <x:Double x:Key="ArborynSpacing6">24</x:Double>
    <x:Double x:Key="ArborynSpacing8">32</x:Double>
    <x:Double x:Key="ArborynSpacing12">48</x:Double>

    <CornerRadius x:Key="ArborynRadiusControl">4</CornerRadius>
    <CornerRadius x:Key="ArborynRadiusCard">8</CornerRadius>
    <CornerRadius x:Key="ArborynRadiusOverlay">8</CornerRadius>
    <CornerRadius x:Key="ArborynRadiusPill">999</CornerRadius>

    <Style x:Key="ArborynDisplayText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource ArborynFontFamily}" />
        <Setter Property="FontSize" Value="68" />
        <Setter Property="LineHeight" Value="92" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="ArborynTitleLargeText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource ArborynFontFamily}" />
        <Setter Property="FontSize" Value="40" />
        <Setter Property="LineHeight" Value="52" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="ArborynTitleText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource ArborynFontFamily}" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="LineHeight" Value="36" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="ArborynSubtitleText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource ArborynFontFamily}" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="LineHeight" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="ArborynBodyLargeText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource ArborynFontFamily}" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="LineHeight" Value="24" />
        <Setter Property="FontWeight" Value="Normal" />
    </Style>
    <Style x:Key="ArborynBodyStrongText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource ArborynFontFamily}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="LineHeight" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="ArborynBodyText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource ArborynFontFamily}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="LineHeight" Value="20" />
        <Setter Property="FontWeight" Value="Normal" />
    </Style>
    <Style x:Key="ArborynCaptionText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource ArborynFontFamily}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="LineHeight" Value="16" />
        <Setter Property="FontWeight" Value="Normal" />
    </Style>

    <Style x:Key="ArborynCardBorder" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource ArborynCardDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource ArborynStrokeCardBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource ArborynRadiusCard}" />
        <Setter Property="Padding" Value="20" />
    </Style>

    <Style x:Key="ArborynSecondaryCardBorder" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource ArborynCardSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource ArborynStrokeCardBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource ArborynRadiusCard}" />
        <Setter Property="Padding" Value="14,12" />
    </Style>

    <Style x:Key="ArborynBadgeBorder" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource ArborynSubtleSecondaryBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource ArborynRadiusPill}" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="ArborynPillButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="CornerRadius" Value="{StaticResource ArborynRadiusPill}" />
        <Setter Property="Padding" Value="12,4" />
        <Setter Property="Background" Value="{ThemeResource ArborynControlDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource ArborynStrokeControlBrush}" />
    </Style>

    <Style x:Key="ArborynSubtleButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Padding" Value="8,5" />
    </Style>

</ResourceDictionary>
